{
  "compilerOptions": {
    // File Layout
    "rootDir": "./source",
    "outDir": "./dist",
    
    // Environment Settings - CAMBIADO PARA NODE
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],
    
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    
    // Stricter Typechecking Options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    
    // Recommended Options
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    
    // Eliminado: "jsx": "react-jsx" (no usamos React en backend)
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  },
  "include": ["source/**/*"],
  "exclude": ["node_modules", "dist", "prisma"]
}